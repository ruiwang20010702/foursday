{
  "name": "foursday",
  "version": "0.9.0-rc.3",
  "description": "A personal-memory-driven open-source work twin for real projects.",
  "bin": {
    "foursday": "scripts/新环境向导.mjs"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "assets/",
    "db/",
    "deploy/",
    "docs/*.md",
    "docs/en/*.md",
    "docs/指南/*.md",
    "distribution/*.json",
    "distribution/plugins/*/*.py",
    "distribution/plugins/*/plugin.yaml",
    "distribution/host/",
    "distribution/profile/",
    "distribution/skills/",
    "distribution/pet/",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    "plugins/foursday/",
    "distribution/claude-plugins/",
    "scripts/",
    "src/*.mjs",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "runtime:setup": "node scripts/安装Foursday运行时.mjs",
    "setup": "node scripts/新环境向导.mjs setup",
    "runtime:configure": "node scripts/配置Foursday运行时.mjs",
    "runtime:gateway": "node scripts/管理FoursdayGateway.mjs",
    "runtime:accept": "node scripts/生成Foursday影子验收.mjs",
    "runtime:activate": "node scripts/管理FoursdayGateway.mjs activate",
    "runtime:verify-mcp": "node scripts/验证RuntimeMCP可靠性.mjs",
    "pet:build": "node scripts/构建Foursday桌宠.mjs",
    "memory:promote": "node scripts/运行个人gbrain记忆晋升.mjs --once",
    "experience:record": "node scripts/记录Foursday真实任务体验.mjs",
    "experience:verify": "node scripts/验证Foursday真实任务体验.mjs",
    "reuse:verify": "node --test test/foursday-cli.test.mjs test/hermes-package.test.mjs test/foursday-hermes-native-install.test.mjs",
    "check": "node scripts/运行代码检查.mjs",
    "check:golden": "node scripts/验证Foursday黄金路径.mjs",
    "check:full": "node scripts/运行完整测试.mjs",
    "check:python": "PYTHONPATH=\"$HOME/.hermes/hermes-agent:$PWD/distribution/plugins:$PWD\" \"$HOME/.hermes/hermes-agent/venv/bin/python\" -m unittest discover -s distribution/tests -p 'test_*.py'",
    "check:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "pg": "8.22.0"
  }
}
