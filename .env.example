# Prefer a private JSON file based on deploy/foursday.example.json.
# These variables document the minimal native Profile contract.
FOURSDAY_CONFIG_FILE=/absolute/private/foursday.json
FOURSDAY_PROJECT_REGISTRY=/absolute/private/projects.json
FOURSDAY_DWS_PATH=/absolute/path/to/dws
FOURSDAY_CODEX_PATH=/absolute/path/to/codex
FOURSDAY_DINGTALK_USERS=trusted-staff-id
FOURSDAY_DINGTALK_GROUPS=
FOURSDAY_DINGTALK_SELF_USER=owner-staff-id
FOURSDAY_DINGTALK_RESPONSIBILITY_REACTIONS=false
FOURSDAY_DINGTALK_RESPONSIBILITY_REACTION=OK
FOURSDAY_DATABASE_URL=
FOURSDAY_DATA_KEY=
FOURSDAY_TENANT_ID=personal
FOURSDAY_GBRAIN_ENABLED=true
FOURSDAY_GBRAIN_MCP_URL=https://gbrain.example.com/mcp
FOURSDAY_GBRAIN_ISSUER_URL=https://gbrain.example.com/oauth
FOURSDAY_GBRAIN_CLIENT_ID=foursday-personal-client
FOURSDAY_GBRAIN_CLIENT_SECRET=
FOURSDAY_GBRAIN_WRITE_ENABLED=false
