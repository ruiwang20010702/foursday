{
  "schemaVersion": 2,
  "workspaces": [
    {
      "id": "example_repo",
      "root": "/absolute/path/to/project",
      "gitRemote": "https://github.com/example/project.git",
      "runInstructions": "Read the project instructions and current evidence before acting."
    }
  ],
  "scopes": [
    {
      "id": "example_project",
      "name": "Example Project",
      "aliases": ["example", "示例项目"],
      "workspaceId": "example_repo",
      "gbrainSlugs": ["projects/example-project"],
      "dingtalkSources": [
        {
          "id": "project_index",
          "name": "Current project index",
          "kind": "doc",
          "nodeId": "EXAMPLEPROJECTDOCNODE1234567890"
        }
      ]
    },
    {
      "id": "example_workstream",
      "name": "Example Workstream",
      "aliases": ["example subproject", "示例子项目"],
      "parentId": "example_project",
      "gbrainSlugs": ["projects/example-workstream"]
    }
  ]
}
